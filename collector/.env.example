# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/wien_oeffi_tracker

# Wiener Linien API
# Register at https://www.data.gv.at/ to get an API key
WIENER_LINIEN_API_KEY=your_api_key_here

# Collection Intervals (in minutes)
WIENER_LINIEN_INTERVAL=3
OEBB_INTERVAL=5

# Optional: Specific stops to monitor (comma-separated external IDs)
# Leave empty to monitor major stations automatically
WIENER_LINIEN_STOPS=
OEBB_STOPS=

# Optional: Enable debug logging
DEBUG=false

# Optional: User agent for API requests
USER_AGENT=wien-oeffi-tracker (github.com/yourname/wien-oeffi-tracker)
